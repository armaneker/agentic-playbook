# OpenRouter key used by the Rubik's cube demo (/demos/rubiks-cube).
# All four models (Claude Fable 5.1, GPT-6 Astra, Grok 4.6, Jev) are called through it.
OPENROUTER_API_KEY=

# Optional. When set, the demo asks for this key before it will call the models.
# Use it if the site is public and you do not want strangers spending your credits.
RUBIKS_DEMO_ACCESS_KEY=

# Used by the read-aloud feature (/api/tts).
OPENAI_API_KEY=
