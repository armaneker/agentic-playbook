# OpenRouter key used by the Rubik's cube demo (/demos/rubiks-cube).
# All four models (Claude Fable 5.1, GPT-6 Astra, Grok 4.6, Jev) are called through it.
OPENROUTER_API_KEY=

# Optional but recommended on a public site. When set, only someone who enters this key on the page
# can start a live race. Everyone else gets replay mode, which calls no models.
RUBIKS_DEMO_ACCESS_KEY=

# Used by the read-aloud feature (/api/tts).
OPENAI_API_KEY=

# Optional. OpenRouter id for Jev. Defaults to typesafe/jev-1.13; the moving alias is ~typesafe/jev-latest.
RUBIKS_JEV_MODEL=
